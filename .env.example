# ==========================================
# BSRU Student Portal — Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามจริง
# ไฟล์ .env จะไม่ถูก commit ขึ้น Git (อยู่ใน .gitignore แล้ว)
#
# ใช้ได้ทั้ง 2 แบบ:
#   - รันบนเครื่อง: start-backend.ps1 / start-backend.bat โหลดไฟล์นี้ให้ (และตั้ง SPRING_PROFILES_ACTIVE=dev)
#   - รันใน Docker: docker compose up -d --build (service backend ใช้ env_file: .env และ profile prod)
#     ใน Docker ค่า SPRING_DATASOURCE_URL จะถูกทับเป็น host "database" ให้อัตโนมัติ
#
# ค่าลับ (JWT_SECRET, SPRING_DATASOURCE_PASSWORD) ไม่มีค่า default ในโค้ดแล้ว
# ถ้าไม่ได้ตั้ง backend จะไม่ยอม start
# ==========================================

# ------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------
# สร้าง API Key ได้ที่: https://aistudio.google.com/apikey
# Key จริงจะขึ้นต้นด้วย AIza...
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# โมเดลที่ใช้ตอบแชท (ไม่ใส่ = gemini-3.5-flash-lite ตามค่าใน application.properties)
# ถ้าเจอ 429 (โควตาเต็ม) หรือ 503 (คนใช้เยอะ) ลองเปลี่ยนเป็นโมเดลอื่น เช่น gemini-3.5-flash
# รายชื่อโมเดล: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------
# PostgreSQL Database
# ------------------------------------------
# docker-compose ใช้ SPRING_DATASOURCE_PASSWORD เป็นรหัสผ่านของ container ฐานข้อมูลด้วย
# (ตอนสร้างฐานข้อมูลครั้งแรก) จึงต้องเป็นค่าเดียวกันเสมอ — เปลี่ยนเป็นรหัสผ่านของคุณเอง
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bsru_student_portal
SPRING_DATASOURCE_USERNAME=bsru_admin
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_db_password

# ------------------------------------------
# JWT Security
# ------------------------------------------
# ต้องยาวอย่างน้อย 32 bytes และต้องเป็นค่าสุ่มที่ไม่มีใครรู้ สร้างได้ด้วย:
#   openssl rand -base64 64
# (ถ้าเว้นว่างไว้ start-backend.ps1 จะสร้างค่าสุ่มและบันทึกลง .env ให้อัตโนมัติ)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# CORS (origin ของหน้าเว็บที่เรียก API ได้)
# ------------------------------------------
# คั่นด้วย comma รองรับ pattern เช่น https://*.bsru.ac.th
# ไม่ใส่ = อนุญาตเฉพาะ localhost / 127.0.0.1 / IP ภายใน (192.168.x.x, 10.x.x.x, 172.16-31.x.x)
# APP_CORS_ORIGINS=https://portal.bsru.ac.th

# ------------------------------------------
# Server Port
# ------------------------------------------
SERVER_PORT=8080
