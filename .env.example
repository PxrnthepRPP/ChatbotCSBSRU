# ==========================================
# BSRU Student Portal — Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามจริง
# ไฟล์ .env จะไม่ถูก commit ขึ้น Git (อยู่ใน .gitignore แล้ว)
#
# ใช้ได้ทั้ง 2 แบบ:
#   - รันบนเครื่อง: start-backend.ps1 / start-backend.bat โหลดไฟล์นี้ให้
#   - รันใน Docker: docker compose up -d --build (service backend ใช้ env_file: .env)
#     ใน Docker ค่า SPRING_DATASOURCE_URL จะถูกทับเป็น host "database" ให้อัตโนมัติ
# ==========================================

# ------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------
# สร้าง API Key ได้ที่: https://aistudio.google.com/apikey
# Key จริงจะขึ้นต้นด้วย AIza...
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# โมเดลที่ใช้ตอบแชท (ไม่ใส่ = gemini-3.7-flash)
# ถ้าเจอ 429 (โควตาเต็ม) หรือ 503 (คนใช้เยอะ) ลองเปลี่ยนเป็น gemini-3.5-flash หรือ gemini-3.5-flash-lite
# รายชื่อโมเดล: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------
# PostgreSQL Database
# ------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bsru_student_portal
SPRING_DATASOURCE_USERNAME=bsru_admin
SPRING_DATASOURCE_PASSWORD=bsru_password

# ------------------------------------------
# JWT Security
# ------------------------------------------
JWT_SECRET=bsru-student-portal-super-secure-and-ultra-secret-jwt-signing-key-2026-cs-bsru-thailand
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# Server Port
# ------------------------------------------
SERVER_PORT=8080
