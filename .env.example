# ==========================================
# BSRU Student Portal — Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามจริง
# ไฟล์ .env จะไม่ถูก commit ขึ้น Git (อยู่ใน .gitignore แล้ว)
# ==========================================

# ------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------
# สร้าง API Key ได้ที่: https://aistudio.google.com/apikey
# Key จริงจะขึ้นต้นด้วย AIza...
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------
# PostgreSQL Database
# ------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bsru_student_portal
SPRING_DATASOURCE_USERNAME=bsru_admin
SPRING_DATASOURCE_PASSWORD=bsru_password

# ------------------------------------------
# JWT Security
# ------------------------------------------
JWT_SECRET=bsru-student-portal-super-secure-and-ultra-secret-jwt-signing-key-2026-cs-bsru-thailand
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# Server Port
# ------------------------------------------
SERVER_PORT=8080
